# ================================
# Database Configuration
# ================================
DATABASE_URL=postgresql://user:password@host:port/database

# ================================
# Redis Configuration (REQUIRED in Production)
# ================================
# Redis is REQUIRED in production for distributed rate limiting across API instances
# Development can work without Redis (uses in-memory fallback)
# Format: redis://[user:password@]host:port[/db]
REDIS_URL=redis://localhost:6379

# ================================
# API Server Configuration
# ================================
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ================================
# Frontend Configuration
# ================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Site URL for metadata and OG images (production)
NEXT_PUBLIC_SITE_URL=https://blink402.dev

# Solana Configuration
# Network: 'devnet' or 'mainnet-beta'
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# RPC endpoints (client and server)
# For production, use a dedicated RPC provider like Helius, QuickNode, or Triton
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# USDC Token Mint (devnet)
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ================================
# ONCHAIN x402 Integration (REQUIRED)
# ================================
# ONCHAIN API for facilitator-based x402 payments
# Get your API key from https://onchain.fi
ONCHAIN_API_KEY=onchain_your_api_key_here
ONCHAIN_API_URL=https://api.onchain.fi/v1

# ================================
# Encryption Configuration (REQUIRED for Creator Payout Keys)
# ================================
# Master encryption key for securing creator payout private keys in database
# This is REQUIRED if you want creators to be able to add their own payout wallets
# Generate ONCE with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store this securely in Railway/your hosting platform - NEVER commit to git!
# If you lose this key, all creator payout keys become unrecoverable!
ENCRYPTION_KEY=your_64_character_hex_string_here

# ================================
# Slot Machine Configuration (DEPRECATED - Now uses creator payout keys)
# ================================
# Old method: Direct private key in environment variable (NOT RECOMMENDED)
# New method: Creators add their keys through /dashboard/payout-setup
# Leave this commented out unless you're using the old single-key method
# SLOT_MACHINE_PAYOUT_PRIVATE_KEY=[31,174,117,179,...]

# ================================
# Privy Wallet Authentication (REQUIRED for Frontend)
# ================================
# Get your Privy App ID from https://dashboard.privy.io
# Used for wallet connection and authentication
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id-here

# ================================
# Treasury & Payment Configuration
# ================================
# Treasury wallet for platform fees (used by PayAI x402 handler)
# This wallet receives platform fees from lottery, slot machine, etc.
TREASURY_WALLET=your_treasury_wallet_public_key_here

# Default payout wallet (fallback if not specified in blink)
# Can be same as TREASURY_WALLET or different
PAYOUT_WALLET=your_payout_wallet_public_key_here

# ================================
# Lottery & Slot Machine Configuration
# ================================
# Platform keypair for automated payouts (JSON array format)
# Generate with: solana-keygen new --outfile keypair.json
# Then: cat keypair.json (copy the array)
# REQUIRED for lottery winner payouts and slot machine payouts
LOTTERY_PLATFORM_KEYPAIR=[31,174,117,179,...]

# ================================
# B402 Token Configuration
# ================================
# B402 token mint address on Solana mainnet
# Used for token holder tiers and buyback features
B402_MINT_ADDRESS=2mESiwuVdfft9PxG7x36rvDvex6ccyY8m8BKCWJqpump

# Raydium pool ID for B402/SOL swaps
# Used for automated buybacks from lottery platform fees
RAYDIUM_POOL_ID=your_raydium_pool_id_here

# ================================
# B402 Auto-Burn System
# ================================
# Burner wallet for deflationary tokenomics
# Every blink execution burns B402 tokens from this wallet
# Generate keypair: solana-keygen new --outfile burner-keypair.json
# Private key format: Base64 string or JSON array [31,174,117,...]
# Public key: For transparency (displayed on homepage)
BURNER_WALLET_PRIVATE_KEY=[31,174,117,179,...]
BURNER_WALLET_PUBLIC_KEY=your_burner_wallet_public_key_here

# Amount of B402 to burn per blink execution
# Default: 100 tokens (adjustable based on tokenomics)
B402_BURN_AMOUNT=100

# Enable/disable auto-burn feature
# Set to 'false' to disable burns (useful for testing)
B402_BURN_ENABLED=true

# ================================
# AI Services (OPTIONAL)
# ================================
# OpenAI API key for AI endpoint discovery feature
# If not provided, AI endpoint finder will use mock data
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# DeepAI API key (optional, for additional AI features)
DEEPAI_API_KEY=your-deepai-api-key-here

# ================================
# Enhanced Solana RPC (OPTIONAL)
# ================================
# Helius API key for enhanced RPC features (webhooks, NFT data, etc.)
# If not provided, standard RPC will be used
# Get your API key from https://www.helius.dev
HELIUS_API_KEY=your-helius-api-key-here

# ================================
# Internal API Security (RECOMMENDED)
# ================================
# API key for protecting internal endpoints (catalog publishing, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, internal endpoints will be unprotected (not recommended for production)
INTERNAL_API_KEY=your_64_character_hex_string_here

# ================================
# Testing Configuration
# ================================
# Enable mock payment verification (bypasses real Solana RPC calls)
# ONLY for development/testing - automatically disabled in production
# MOCK_PAYMENTS=true

# ================================
# Optional: Analytics and Monitoring
# ================================
# NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id
